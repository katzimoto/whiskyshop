# Local development only. Copy to .env and replace values as needed.
WORDPRESS_PORT=8080
WP_HOME=http://localhost:8080
WP_SITEURL=http://localhost:8080
WP_DEBUG=true

DB_NAME=omef
DB_USER=omef
DB_PASSWORD=change-this-local-password
DB_ROOT_PASSWORD=change-this-local-root-password

# Outgoing mail (empty SMTP_USER/PASSWORD -> local Mailpit relay)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=noreply@omef.test
SMTP_USER=
SMTP_PASSWORD=
