# Copy to .env.local / .env.staging / .env.production — never commit real values.

# --- Environment ---
WP_ENV=local                     # local | staging | production
WP_HOME=http://localhost:8080
WP_SITEURL=${WP_HOME}/wp

# --- Database ---
DB_NAME=omef
DB_USER=omef
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme
DB_HOST=db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Integration adapters (see inc/integrations) ---
# Defaults to mock everywhere except production. Production boot fails loudly
# if either driver still resolves to "mock" — see inc/integrations/container.php.
PAYMENT_DRIVER=mock              # mock | payplus | cardcom
INVOICE_DRIVER=mock              # mock | greeninvoice
FEED_DRIVER=mock                 # mock | spotify
MAIL_DRIVER=mock                 # mock | live

PAYPLUS_KEY=
PAYPLUS_SECRET=
CARDCOM_TERMINAL=
CARDCOM_USER=
GI_ID=
GI_SECRET=
SPOTIFY_FEED_URL=

# --- Backups ---
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
